<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 
              Pattern definition:
              1. Date, Thread, Level, Logger
              2. Replaces Email patterns with [REDACTED_EMAIL]
              3. Replaces Phone number patterns with [REDACTED_PHONE]
            -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %replace(%replace(%msg){'[a-zA-Z0-9_+&amp;*-]+(?:\\.[a-zA-Z0-9_+&amp;*-]+)*@(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,7}', '[REDACTED_EMAIL]'}){'\\+?[0-9]{10,14}', '[REDACTED_PHONE]'}%n</pattern>
        </encoder>
    </appender>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>
